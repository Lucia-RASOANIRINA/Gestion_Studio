# --- Database ---
DB_USER=gestion_studio
DB_PASSWORD=gestion_studio
DB_NAME=gestion_studio
DB_PORT=5433
DATABASE_URL="postgresql://gestion_studio:gestion_studio@localhost:5433/gestion_studio?schema=public"

# --- Redis ---
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# --- MinIO (S3-compatible storage) ---
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=gestion_studio
MINIO_ROOT_PASSWORD=gestion_studio_secret
MINIO_BUCKET=gestion-studio

# --- API ---
API_PORT=3000
NODE_ENV=development
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:4200

# --- Locale ---
DEFAULT_TIMEZONE=Indian/Antananarivo
DEFAULT_CURRENCY=MGA
DEFAULT_LOCALE=fr

# --- Web (Angular) ---
WEB_PORT=4200
API_BASE_URL=http://localhost:3000/api
