// Schéma Prisma — fondations (utilisateurs, rôles, permissions, audit),
// Clients & Contacts (phase 2) et Projets & Services (phase 3).
// Les modèles des phases suivantes (planning, ressources, facturation, reporting)
// seront ajoutés phase par phase, avec leurs migrations dédiées.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PermissionModule {
  CLIENTS
  PROJECTS
  PLANNING
  RESOURCES
  BILLING
  REPORTING
  SETTINGS
  USERS
}

enum PermissionAction {
  READ
  CREATE
  UPDATE
  DELETE
  EXPORT
  VALIDATE
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  locale       String    @default("fr")
  theme        String    @default("dark")
  isActive     Boolean   @default(true)
  failedLoginAttempts Int @default(0)
  lockedUntil  DateTime?
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  roles        UserRole[]
  refreshTokens RefreshToken[]
  auditLogs    AuditLog[]
  createdClients  Client[]
  createdProjects Project[]
  createdBookings Booking[] @relation("BookingCreatedBy")
  engineerBookings Booking[] @relation("BookingEngineer")
  createdEquipment Equipment[]
  createdConsumables Consumable[]
  createdInvoices Invoice[]
  createdPayments Payment[]
  createdExpenses Expense[]
  createdStudios Studio[]
  createdMaintenance MaintenanceRecord[]
  createdEmployees Employee[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)

  users       UserRole[]
  permissions RolePermission[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id     String            @id @default(uuid())
  module PermissionModule
  action PermissionAction

  roles  RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model UserRole {
  userId String
  roleId String

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

/// Journal d'audit — non modifiable a posteriori (pas d'update/delete exposés côté applicatif).
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@map("audit_logs")
}

enum ClientSegment {
  ARTIST
  LABEL
  ADVERTISING_AGENCY
  COMPANY
  INSTITUTION
  OTHER
}

model Client {
  id               String        @id @default(uuid())
  name             String
  segment          ClientSegment @default(OTHER)
  email            String?
  phone            String?
  address          String?
  notes            String?
  reliabilityScore Int           @default(100)

  // Fidélité : points cumulés (1 pt / 10 000 Ar payés). Le niveau (tier) est dérivé
  // des points côté service, jamais stocké, pour rester cohérent après ajustement.
  loyaltyPoints    Int           @default(0)
  isBlacklisted    Boolean       @default(false)
  blacklistReason  String?

  createdById      String?
  createdBy        User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)

  projects         Project[]
  invoices         Invoice[]

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@map("clients")
}

enum ServiceType {
  RECORDING
  MIXING
  MASTERING
  POST_PRODUCTION
  VOICE_OVER
  EQUIPMENT_RENTAL
  LIVE_EVENT
  OTHER
}

enum ProjectStatus {
  QUOTE
  VALIDATED
  IN_PROGRESS
  REVIEW
  DELIVERED
  INVOICED
  ARCHIVED
}

enum Currency {
  MGA
  EUR
  USD
}

model Project {
  id             String        @id @default(uuid())
  reference      String        @unique
  title          String
  serviceType    ServiceType
  status         ProjectStatus @default(QUOTE)
  description    String?
  budgetAmount   Decimal?      @db.Decimal(14, 2)
  budgetCurrency Currency      @default(MGA)
  startDate      DateTime?
  dueDate        DateTime?

  // Avancement (0-100 %) et check-list avant livraison stockée en JSON
  // (tableau d'objets { label, done }).
  progress       Int           @default(0)
  checklist      Json?

  clientId       String
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)

  createdById    String?
  createdBy      User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  bookings       Booking[]
  invoices       Invoice[]

  @@map("projects")
}

enum StudioRoom {
  STUDIO_A
  STUDIO_B
  STUDIO_C
  MOBILE
}

enum BookingType {
  SESSION
  UNAVAILABILITY
}

/// Réservations de studio — la détection de conflits (même studio ou même
/// ingénieur sur une plage horaire qui se chevauche) est appliquée en service,
/// jamais uniquement côté frontend.
model Booking {
  id        String      @id @default(uuid())
  studio    StudioRoom
  type      BookingType @default(SESSION)
  title     String
  startAt   DateTime
  endAt     DateTime
  notes     String?

  projectId String?
  project   Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)

  engineerId String?
  engineer   User?      @relation("BookingEngineer", fields: [engineerId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?     @relation("BookingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("bookings")
}

enum EquipmentCategory {
  MICROPHONE
  CONSOLE
  INTERFACE
  MONITOR
  INSTRUMENT
  CABLE
  OTHER
}

enum EquipmentStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  RETIRED
}

/// Amortissement/valeur résiduelle suivis manuellement (purchasePrice/currentValue)
/// plutôt que calculés automatiquement, pour laisser la comptabilité ajuster
/// selon sa propre méthode d'amortissement.
model Equipment {
  id            String            @id @default(uuid())
  name          String
  category      EquipmentCategory @default(OTHER)
  serialNumber  String?
  brand         String?
  model         String?
  location      String?
  status        EquipmentStatus   @default(AVAILABLE)
  studio        StudioRoom?
  purchaseDate  DateTime?
  warrantyUntil DateTime?
  purchasePrice Decimal?          @db.Decimal(14, 2)
  currentValue  Decimal?          @db.Decimal(14, 2)
  photoUrl      String?
  // Date de la prochaine maintenance planifiée : sert à générer une alerte
  // (« maintenance prévue dans X jours ») côté notifications.
  nextMaintenanceAt DateTime?
  notes         String?

  createdById   String?
  createdBy     User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)

  maintenanceRecords MaintenanceRecord[]

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@map("equipment")
}

/// Historique de maintenance/réparation d'un équipement (coût, technicien, pièces).
model MaintenanceRecord {
  id            String    @id @default(uuid())
  equipmentId   String
  equipment     Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  performedAt   DateTime  @default(now())
  description   String
  cost          Decimal?  @db.Decimal(14, 2)
  technician    String?
  partsReplaced String?

  createdById   String?
  createdBy     User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt     DateTime  @default(now())

  @@map("maintenance_records")
}

/// Fil de notifications persistant : une entrée par événement métier
/// (création, mise à jour, paiement, connexion…). L'acteur est dénormalisé
/// (`actorName`) pour rester lisible même si l'utilisateur est supprimé.
model Notification {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String?
  actorId   String?
  actorName String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
  @@map("notifications")
}

enum StudioType {
  RECORDING
  PODCAST
  LIVE
  VIDEO
  REHEARSAL
  OTHER
}

enum StudioStatus {
  AVAILABLE
  MAINTENANCE
  CLOSED
}

// --- Ressources Humaines ---

enum EmployeeType {
  EMPLOYEE
  FREELANCE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

model Employee {
  id         String         @id @default(uuid())
  firstName  String
  lastName   String
  position   String
  type       EmployeeType   @default(EMPLOYEE)
  email      String?
  phone      String?
  hireDate   DateTime?
  dailyRate  Decimal?       @db.Decimal(14, 2)
  status     EmployeeStatus @default(ACTIVE)
  notes      String?

  leaveRequests LeaveRequest[]

  createdById String?
  createdBy   User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@map("employees")
}

enum LeaveType {
  LEAVE
  SICK
  UNPAID
  OVERTIME
  ABSENCE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Congés, absences et heures supplémentaires d'un employé.
model LeaveRequest {
  id         String      @id @default(uuid())
  employeeId String
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       LeaveType   @default(LEAVE)
  startDate  DateTime
  endDate    DateTime
  status     LeaveStatus @default(PENDING)
  reason     String?

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@map("leave_requests")
}

/// Catalogue des studios/salles (capacité, tarif, équipements, disponibilité).
model Studio {
  id               String       @id @default(uuid())
  name             String
  type             StudioType   @default(RECORDING)
  capacity         Int          @default(1)
  hourlyPrice      Decimal?     @db.Decimal(14, 2)
  status           StudioStatus @default(AVAILABLE)
  description      String?
  equipmentSummary String?
  photoUrl         String?
  notes            String?

  createdById      String?
  createdBy        User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@map("studios")
}

/// Stocks consommables (câbles, piles, etc.) — l'alerte de stock bas est
/// dérivée de `quantity <= lowStockThreshold`, pas stockée en base.
model Consumable {
  id                String   @id @default(uuid())
  name              String
  unit              String   @default("unité")
  quantity          Int      @default(0)
  lowStockThreshold Int      @default(10)
  notes             String?

  createdById       String?
  createdBy         User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("consumables")
}

// --- Facturation & Finances (phase 6) ---

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  BANK_TRANSFER
  CARD
  OTHER
}

/// Les montants (sous-total, TVA, total, solde) sont calculés à la volée à partir
/// des lignes et des paiements, jamais stockés, pour rester cohérents en cas de
/// modification d'une ligne. Seul `taxRate` (%) est stocké par facture.
model Invoice {
  id          String        @id @default(uuid())
  reference   String        @unique
  status      InvoiceStatus @default(DRAFT)
  issueDate   DateTime      @default(now())
  dueDate     DateTime?
  currency    Currency      @default(MGA)
  taxRate     Decimal       @default(20) @db.Decimal(5, 2)
  notes       String?

  // Signature électronique : image (data URL PNG) capturée à la souris/tablette.
  // Une fois signée, la facture est verrouillée (ni édition ni changement de statut).
  signatureDataUrl String?  @db.Text
  signedBy         String?
  signedAt         DateTime?

  clientId    String
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)

  projectId   String?
  project     Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)

  items       InvoiceItem[]
  payments    Payment[]

  createdById String?
  createdBy   User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal @default(0) @db.Decimal(14, 2)

  createdAt   DateTime @default(now())

  @@map("invoice_items")
}

model Payment {
  id          String        @id @default(uuid())
  invoiceId   String
  invoice     Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount      Decimal       @db.Decimal(14, 2)
  method      PaymentMethod @default(MOBILE_MONEY)
  reference   String?
  paidAt      DateTime      @default(now())

  createdById String?
  createdBy   User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt   DateTime      @default(now())

  @@map("payments")
}

enum ExpenseCategory {
  SALARY
  RENT
  INTERNET
  ELECTRICITY
  MAINTENANCE
  TAX
  EQUIPMENT
  SUPPLIES
  OTHER
}

/// Dépenses de la structure (charges, salaires, taxes…) — la trésorerie (entrées
/// vs sorties) est calculée à la volée en confrontant paiements et dépenses.
model Expense {
  id          String          @id @default(uuid())
  label       String
  category    ExpenseCategory @default(OTHER)
  amount      Decimal         @db.Decimal(14, 2)
  currency    Currency        @default(MGA)
  incurredAt  DateTime        @default(now())
  notes       String?

  createdById String?
  createdBy   User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("expenses")
}
