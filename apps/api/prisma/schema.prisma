// Schéma Prisma — fondations (utilisateurs, rôles, permissions, audit),
// Clients & Contacts (phase 2) et Projets & Services (phase 3).
// Les modèles des phases suivantes (planning, ressources, facturation, reporting)
// seront ajoutés phase par phase, avec leurs migrations dédiées.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PermissionModule {
  CLIENTS
  PROJECTS
  PLANNING
  RESOURCES
  BILLING
  REPORTING
  SETTINGS
  USERS
}

enum PermissionAction {
  READ
  CREATE
  UPDATE
  DELETE
  EXPORT
  VALIDATE
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  locale       String    @default("fr")
  isActive     Boolean   @default(true)
  failedLoginAttempts Int @default(0)
  lockedUntil  DateTime?
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  roles        UserRole[]
  refreshTokens RefreshToken[]
  auditLogs    AuditLog[]
  createdClients  Client[]
  createdProjects Project[]
  createdBookings Booking[] @relation("BookingCreatedBy")
  engineerBookings Booking[] @relation("BookingEngineer")

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)

  users       UserRole[]
  permissions RolePermission[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id     String            @id @default(uuid())
  module PermissionModule
  action PermissionAction

  roles  RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model UserRole {
  userId String
  roleId String

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

/// Journal d'audit — non modifiable a posteriori (pas d'update/delete exposés côté applicatif).
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@map("audit_logs")
}

enum ClientSegment {
  ARTIST
  LABEL
  ADVERTISING_AGENCY
  COMPANY
  INSTITUTION
  OTHER
}

model Client {
  id               String        @id @default(uuid())
  name             String
  segment          ClientSegment @default(OTHER)
  email            String?
  phone            String?
  address          String?
  notes            String?
  reliabilityScore Int           @default(100)

  createdById      String?
  createdBy        User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)

  projects         Project[]

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@map("clients")
}

enum ServiceType {
  RECORDING
  MIXING
  MASTERING
  POST_PRODUCTION
  VOICE_OVER
  EQUIPMENT_RENTAL
  LIVE_EVENT
  OTHER
}

enum ProjectStatus {
  QUOTE
  VALIDATED
  IN_PROGRESS
  REVIEW
  DELIVERED
  INVOICED
  ARCHIVED
}

enum Currency {
  MGA
  EUR
  USD
}

model Project {
  id             String        @id @default(uuid())
  reference      String        @unique
  title          String
  serviceType    ServiceType
  status         ProjectStatus @default(QUOTE)
  description    String?
  budgetAmount   Decimal?      @db.Decimal(14, 2)
  budgetCurrency Currency      @default(MGA)
  startDate      DateTime?
  dueDate        DateTime?

  clientId       String
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)

  createdById    String?
  createdBy      User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  bookings       Booking[]

  @@map("projects")
}

enum StudioRoom {
  STUDIO_A
  STUDIO_B
  STUDIO_C
  MOBILE
}

enum BookingType {
  SESSION
  UNAVAILABILITY
}

/// Réservations de studio — la détection de conflits (même studio ou même
/// ingénieur sur une plage horaire qui se chevauche) est appliquée en service,
/// jamais uniquement côté frontend.
model Booking {
  id        String      @id @default(uuid())
  studio    StudioRoom
  type      BookingType @default(SESSION)
  title     String
  startAt   DateTime
  endAt     DateTime
  notes     String?

  projectId String?
  project   Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)

  engineerId String?
  engineer   User?      @relation("BookingEngineer", fields: [engineerId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?     @relation("BookingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("bookings")
}
